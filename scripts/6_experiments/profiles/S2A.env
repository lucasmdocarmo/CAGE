# S2 landing A (session s2a): the 70B on Qasper, four H200 at TP 4, vLLM and SGLang.
# Built from S1.env (the registered S1 profile) under the block E picks of
# 2026-11-01 (MyDocs/RunPod/S2_BLOCK_E_LANDING_2026-11-01.md); every S1.env key
# has a value here. The bounds come from the S1 landing's measured stages
# (experiments/S1/2026-10-23_2350, extras/state.json) scaled to this landing's rows.
EXP=S2A
SESSION=s2a
# S2 block F batch 2/3 spec finding 1, decision 1 (owner 2026-11-03): the ladder registers
# the floor artifact at the grid's floor rung (floor_budget_r = 1.0 on this session) and
# stage 5 refuses any other fraction, so the S1 control rung 1.25 (ADR-0175 item 5) is out
CALIBRATION_BUDGET_FRACTION=1.0
# B4, carried from S1: each class's floor on the floor start
CLASS_FLOORS=1
# FRONTIER_LOADS=0 (owner 2026-11-15, "ok A then"): the frontier rule (ADR-0175 amendment)
# places S1's K1 loads; no block of this session registers a frontier load (its loads are
# 0.95 and 1.05 of the cell's own rate), so the stage 6 frontier job could change nothing
# in the plan and could only refuse, as it did on landing S2R 2026-11-14 (no vLLM anchor
# window at r=0.5 or r=0.25 reached the 0.9 timely share; 2.9 h of pod time). The value was
# 1, carried from S1. tests/test_s2r_followups_batch3.py holds the key to the grid.
FRONTIER_LOADS=0
# S2 block A-6 (DEC-2 (b)): the Qasper questions packed in the 70B's own tokens
# (2,640-token blocks, 50-question warm-up reserve). Built on 2026-11-19 with
# build_query_manifest.py --tokenizer meta-llama/Llama-3.3-70B-Instruct
# --tokenizer-revision 6f6073b423013f6a7d4d9f39144961bfbfbc386b --block-budget 2640
# --trunc-budgets 700: 846 questions per trial, the trial pool at that block and
# reserve (owner decision D1, 2026-11-19; the word-count manifest held 852).
QUERY_MANIFESTS="qasper=data/manifests/qasper_846x12_seed42_wr50_tok-Llama-3.3-70B-Instruct.json"
CALIBRATION_MANIFEST=data/manifests/qasper_846x12_seed42_wr50_tok-Llama-3.3-70B-Instruct.json
# CHARTER_DATASETS stays the common three (the preflight needs every plan dataset
# staged, not the reverse); narrowing it to qasper would only trim the staging time.
# DEC-1 (iv) and block B-4 option a: the weights on the container disk. Since 2026-11-21
# (final review, question 1 (a)) the results root and the backup mirror live there too
# (POD_RESULTS_DIR below), so the 300 GB volume carries the repo and the archive of the
# run tree (no script deletes it)
VOLUME_GB=300
# DISK_GB 400 (owner 2026-11-21, final review question 4 (b), "approve all as recomended";
# 300 before): the results and their mirror now share the disk with the 141 GB of weights,
# and the S2R pod of 2026-11-14 (300 GB) went from 91 GiB free at stage 3 to 65 GiB at
# stage 11 with 2.7 GB of those 26 GB explained [?] (S2B.env states 400 for the same reason)
DISK_GB=400
# S2 plan section 6: the budget stop five hours before the HOURS bound, so the run
# seals its tree with sentinels instead of being killed at the bound (45 until 2026-11-20;
# 50 since, except on 2026-11-21, when it read 45 for one day; see HOURS)
RUN_BUDGET_HOURS=50
LAST_BLOCK=
# A10: the served model at its freeze-file revision (slot served_model_llama33_70b,
# read 2026-11-01), offline, checked against the Hub at setup
PIN_MODEL_REVISION=1
CAMPAIGN=camp1
MODEL=meta-llama/Llama-3.3-70B-Instruct
MODEL_SLUG=llama-3.3-70b
# RunPod gpu id spelling; stage 0's stock read validates it fail-closed.
GPU_ID="NVIDIA H200"
GPU_COUNT=4
# The s2a plan has no hf cell; both served engines are calibrated
ENGINES="vllm sglang"
CALIBRATE="vllm sglang"
TOPOLOGY=tp
# S2 plan decision 8 (2026-10-30): volume-capable datacenters with H200 stock; re-read on GO day
DC_PREFS="US-CA-2 US-CO-1 CA-MTL-3 CA-MTL-4 EU-FR-1 AP-JP-1"
# The run bound. The grid ruled on 2026-11-19 (92 cells, 200 windows) has 254 plan steps
# and projects 48.45 h on the S0 14B step table at the fixture's rates [V 2026-11-20, on
# that nine-arm grid; the tests pin the eight-arm grid since 2026-11-21]; with the pre-load compression of the retr-comp
# windows set to zero it projects 44.73 h [V review 2026-11-20]. The pod's figure is [?]:
# stage 6 re-projects from the measured rates, after calibration has billed, and compares
# with HOURS only (stage 0 does not project the run). Owner 2026-11-20 ("Raise the
# limits"): 55 with the stop at 50, because at the table's rates a 45 h stop refused the
# last four serving segments, 16 of the 20 no-load references. Before: HOURS=50 and
# RUN_BUDGET_HOURS=45, sized on the earlier grid (268 steps, 46.7 h, S2 plan section 6).
# Owner 2026-11-21 ("ok drop B7 from both, 8 arms. lets go", S2 plan section 19): the
# eight-arm grid (82 cells, 178 windows, 226 plan steps) projects 42.55 h on the same
# table [V tests/test_s2a_eight_arms.py]. The limits went to 50 and 45 that day (decision
# D1 (b)) and never reached a pod. Owner 2026-11-22 ("back to 55/50/88", review M1): 55 and
# 50 are kept. The pod's projection at stage 6 uses the measured floors and B9's rate
# limit, and a projection above HOURS refuses there, after calibration has billed. The
# remedy is to raise HOURS here and resume from the plan stage: the calibration is kept,
# because its key is written at stage 0 and stage 0 is not run again, and the pod bills
# while the operator acts [V tests/test_s2a_eight_arms_master.py]. An earlier wording of
# this comment said stage 5 would measure again; the second review of 2026-11-22 (M1)
# showed that was wrong. 55 leaves 12.45 h over the fixture's projection and the stop
# leaves 7.45 h (6.55 h and 1.55 h on the nine-arm grid). Against 50, 45 and 83h, stage 0
# asks for 105.80 USD more at 5.29 USD per GPU-hour (the price read on 2026-11-21): a
# deposit, not a cost.
HOURS=55
# S1 fetched 28 GB of weights in 15 min of setup (about 290 MB/s) [V]; 141 GB plus
# the helpers at that rate are about 25 min [D]; 40 holds a slower mirror
SETUP_BOUND_MIN=40
# S2 block F batch 2/3 spec finding 4, decision 3 option (a) (owner 2026-11-03): this
# landing laddered 15 triples per engine (30 in all), which exceed the S1 bound of 18,000 s
# at the S1 pace; 32,400 s (9 h per engine) holds them; the 70B's window speed at TP 4 is [A].
# Since 2026-11-19 the grid ladders 10 triples per engine (five classes at two rungs);
# since 2026-11-21, 8 (four classes: the class of B7 left with it). The bound is kept.
CALIBRATE_RUNGS_BOUND_S=32400
# S1's scoring pass took 136 min for 365,410 served rows; 337,758 of them inherited an
# earlier score (the same question, answer and context) and 27,652 were scored: 0.295 s
# per scored row [V S1 score.log and state.json; D]. Scoring time follows the distinct
# answers, not the served rows. 95,228 is this landing's NOMINAL row count (160 windows
# of the 500-question pool plus 18 references of 846; 106,920 with B7, before 2026-11-21;
# 108,704 on the grid before 2026-11-19), not a served count. If this landing's rows
# inherit at S1's share (92.4 percent), the pass takes about 35 min on the nominal count
# [D]. If every one of the 15,228 reference rows is scored and none inherits, it takes
# 75 min at S1's speed [D]. 120 holds that second case with a 1.6x margin; longer 70B
# answers are [A] (reworded 2026-11-21; this comment read "120 holds rows three times
# slower")
SCORE_BOUND_MIN=120
# ADR-0176 Group D, carried from S1: batched scoring behind the stage 10 probe
SCORING_BATCH_SIZE=32
# S2 block F row F-11 (owner 2026-11-04, option (a)): the per-row bounds the proof
# allows on the two continuous exploratory fields; every predicate input stays
# exact. 0.005 = 10 percent of the 0.05 window margin (S1 measured 0.0035);
# 1e-5 holds the measured 2.2e-6 with headroom.
SCORING_TOL_FAITHFULNESS=0.005
SCORING_TOL_BERTSCORE=1e-5
# S1 pulled its 14 GB run tree (365,410 served rows) in 242 min [V]. 95,228 is this
# landing's NOMINAL count (160 windows of the 500-question pool plus 18 references of
# 846; 106,920 with B7), not a served count: a window issues load x rate limit x window
# length requests and replays its pool up to 15 passes (S1's nominal count was 225,976
# and it served 365,410, 1.62 times). At S1's pull rate the nominal count is 63 min and
# 1.62 times it is 102 min [D]; 150 holds up to 2.3 times the nominal count. Stage 6 prints the
# arrivals from the measured rates (corrected 2026-11-21; this comment read "29
# percent of the rows")
PULL_MARGIN_MIN=150
# seatbelt >= readiness 15 + setup 40 + validate (20 + pod suite 125 + 2 x 25 +
# start check 40) + calibrate 2 x (60 + 540) + plan 15 + run 3300 + seal 10 +
# score 120 + collect 30 + pull 150 = 5,115 min (85.25 h, which the master prints as 85.2) [D, stage_bound_minutes;
# ADR-0196 moved the pod suite from 30 to 125 min; HOURS=55 moved the run from 3,000 to
# 3,300 on 2026-11-20, the sum was 4,815; 50 and 83h stood on 2026-11-21 only];
# 88h = 5,280 min keeps the 165 min margin 83h held over 4,815 (260 before ADR-0196; 75h held 260 over the 18,000 s bound, decision 3)
SEATBELT=88h
# ADR-0177 bound, unused while CLASS_CEILINGS=0 (block E: no ceiling-only ladders on S2)
CLASS_CEILINGS_BOUND_S=36000
CLASS_CEILINGS=0
# S0F-88 B-9 (owner ruling R5): every class laddered at its rungs
RUNG_ALL_CLASSES=1
# The served model plus the seven helpers; no Qwen3-14B on S2 (no pod reader defaults to it)
PREFETCH_MODELS="meta-llama/Llama-3.3-70B-Instruct intfloat/e5-large-v2 BAAI/bge-reranker-large microsoft/llmlingua-2-xlm-roberta-large-meetingbank KRLabsOrg/lettucedect-base-modernbert-en-v1 MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli sentence-transformers/all-MiniLM-L6-v2 roberta-base"
# G14 hang guards, carried from S1 [A until the S2 step times are measured]
STEP_TIMEOUT_S=7200
LADDER_FAIL_FAST=1
CELL_STALL_MIN=60
BACKUP_ARCHIVE_DIR=/workspace/backup-archives
# Final review question 1 (a) (owner 2026-11-21, "approve all as recomended"), as S2R.env
# and S2B.env since follow-ups item 6 (2026-11-15) and S0F-39 on S0: every cell directory
# is its row key, which carries "|"; the US-CA-2 network volume (NFS, vast backend), first
# in DC_PREFS, refused that character on landing S2R 2026-11-14 (EINVAL 22), and stage 2
# stops a landing whose results root refuses it. The results root and the backup mirror
# live on the container disk; stage 12 pulls them to the Mac and the archive above stays
# on the volume. The pod's disk is not durable: a stopped pod loses both.
POD_RESULTS_DIR=/root/cage-results
POD_BACKUP_DIR=/root/backup
BACKUP_TARGET=file:///root/backup
# S2 block F row F-10 (ADR-0185) and batch 2/3 spec finding 2, decision 2 option (B)
# (owner 2026-11-03): the E12 gate judges the two registered pressure loads exactly, at
# the count the grid registers per group (2 windows at 0.95, 3 at 1.05); the block E
# floor of six was unreachable by construction. The roster names the confirmatory arms:
# their groups block the landing, the other arms' groups are descriptive.
# Owner decisions A-G1 and A-G2 (2026-11-19): only load 1.05 gates, at its three
# registered windows, and the five core arms block; the 0.95 windows are recorded and
# reported, never gated, and B2, B5, B9 and B10 are descriptive (projection 2026-11-19:
# 36 gated groups, 20 blocking, 16 descriptive). The values before that day were
# "0.95 1.05", "0.95:2 1.05:3" and a roster that also named B11 and B12.
# Owner 2026-11-21 ("ok drop B7 from both, 8 arms. lets go"): B7 left the session, so
# four core arms block (projection: 32 gated groups, 16 blocking, 16 descriptive; 48
# windows must all qualify, 60 with B7). Stage 0 refuses a roster arm the grid does
# not serve.
REGIME_GATE_LOADS="1.05"
MIN_IN_REGIME_WINDOWS="1.05:3"
CONFIRMATORY_ARMS="B1 B3 B4 B6"
# ADR-0175 item 7, carried from S1
MAX_NULL_FRACTION=0.06
# AN-2 (ADR-0211, owner 2026-11-20: "Yes, all as recommended"): the look requests the seven
# no-load contrasts whose two arms this session serves; each resolves to one pair per engine
# on the cells the session plans (tests/test_s2a_an2_analysis_list.py). #9 (B8 against B6) is
# left out: B8 is not on s2a and the driver refuses the whole look on a contrast without
# cells. The metrics are the registered pair of #4: first-token time and the accepted-answer
# predicate. The continuous faithfulness score is NOT listed (review 2026-11-20): a campaign
# tree's requests.jsonl carries it as a null (the runner serves with the quality scorers off),
# the loader joins no other column for it, and the look refuses a metric with no column. The
# values before that day were the common "4" and ttft_ms.
CONTRASTS="1 2 3 4 5 7 8"
ANALYSIS_METRICS="ttft_ms predicate"
# S0F-72, carried from S1 [A on four H200]: the floor table's concurrency target
FLOOR_CONCURRENCY=50
# ADR-0155, register A-5 (owner 2026-11-21, ADR-0213): the anchor shape the s2a grid
# registers, the mean served tokens of the gold arm on Qasper in Llama-3.3-70B tokens
# (S1's no-load windows re-rendered on 2026-11-21; 4779, the S0 mean in Qwen3-14B
# tokens, before that day). Stage 0 refuses a value that differs from the grid's.
FLOOR_AVG_SEQ_TOKENS=4978
# Block E pick: the pod suite runs too; the Mac suite stays the free gate
SUITE_ON_POD=1
# ADR-0196: the 2026-11-07 rehearsal's pod suite took 4,821 s on this shape (one run) against
# the former 1,800 s; 7,500 s holds it with a 1.56x margin [A] and counts 125 min at stage 4
POD_SUITE_BOUND_S=7500
MAC_SUITE=1
FRONT_LOAD=0
# S0F-35 lever, carried from S1 [A on the 70B]
CAGE_SGLANG_DISABLE_PIECEWISE_CUDA_GRAPH=1
# No retr-store (B8) cell on s2a: no LMCache
INSTALL_LMCACHE=0
LMCACHE_VERSION=
# The s2a plan carries no blocked row since 2026-11-19 (B12, whose four corpus-trunc
# rows were blocked on Qasper, left the session), so stage 7 runs every row under 0.
SKIP_BLOCKED=0
# S2 block E-2 (owner 2026-11-01): the owner's Hub token file on this Mac, outside
# the repo, mode 600, written unquoted so bash expands the ~. Stage 0 refuses a
# missing, empty, 644 or in-repo file before anything bills; stage 2 copies it to
# the pod's token path as a file. The token never enters a variable or a log.
HF_TOKEN_FILE=~/.cache/huggingface/token
