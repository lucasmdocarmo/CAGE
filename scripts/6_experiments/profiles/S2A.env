# S2 landing A (session s2a): the 70B on Qasper, four H200 at TP 4, vLLM and SGLang.
# Built from S1.env (the registered S1 profile) under the block E picks of
# 2026-11-01 (MyDocs/RunPod/S2_BLOCK_E_LANDING_2026-11-01.md); every S1.env key
# has a value here. The bounds come from the S1 landing's measured stages
# (experiments/S1/2026-10-23_2350, extras/state.json) scaled to this landing's rows.
EXP=S2A
SESSION=s2a
# S2 block F batch 2/3 spec finding 1, decision 1 (owner 2026-11-03): the ladder registers
# the floor artifact at the grid's floor rung (floor_budget_r = 1.0 on this session) and
# stage 5 refuses any other fraction, so the S1 control rung 1.25 (ADR-0175 item 5) is out
CALIBRATION_BUDGET_FRACTION=1.0
# B4, carried from S1: each class's floor on the floor start
CLASS_FLOORS=1
# ADR-0175 amendment, carried from S1: the loads from the frontier rule on the anchor ladders
FRONTIER_LOADS=1
# S2 block A-6 (DEC-2 (b)): the Qasper questions packed in the 70B's own tokens
# (2,640-token blocks, 50-question warm-up reserve). The file does not exist yet:
# the Hub account is not authorized for the gated repo, so its tokenizer cannot be
# loaded; stage 0 refuses with the plain "do not exist" message until it is built
# with build_query_manifest.py --tokenizer meta-llama/Llama-3.3-70B-Instruct
# --tokenizer-revision 6f6073b423013f6a7d4d9f39144961bfbfbc386b --block-budget 2640.
QUERY_MANIFESTS="qasper=data/manifests/qasper_852x12_seed42_wr50_tok-Llama-3.3-70B-Instruct.json"
CALIBRATION_MANIFEST=data/manifests/qasper_852x12_seed42_wr50_tok-Llama-3.3-70B-Instruct.json
# CHARTER_DATASETS stays the common three (the preflight needs every plan dataset
# staged, not the reverse); narrowing it to qasper would only trim the staging time.
# DEC-1 (iv) and block B-4 option a: the weights on the 300 GB container disk; the
# 300 GB volume carries the repo, the landing tree and the backup (no script deletes it)
VOLUME_GB=300
DISK_GB=300
# S2 plan section 6: the budget stop five hours before the HOURS bound, so the run
# seals its tree with sentinels instead of being killed at the bound
RUN_BUDGET_HOURS=45
LAST_BLOCK=
# A10: the served model at its freeze-file revision (slot served_model_llama33_70b,
# read 2026-11-01), offline, checked against the Hub at setup
PIN_MODEL_REVISION=1
CAMPAIGN=camp1
MODEL=meta-llama/Llama-3.3-70B-Instruct
MODEL_SLUG=llama-3.3-70b
# RunPod gpu id spelling; stage 0's stock read validates it fail-closed.
GPU_ID="NVIDIA H200"
GPU_COUNT=4
# The s2a plan has no hf cell; both served engines are calibrated
ENGINES="vllm sglang"
CALIBRATE="vllm sglang"
TOPOLOGY=tp
# S2 plan decision 8 (2026-10-30): volume-capable datacenters with H200 stock; re-read on GO day
DC_PREFS="US-CA-2 US-CO-1 CA-MTL-3 CA-MTL-4 EU-FR-1 AP-JP-1"
# S2 plan section 6: 268 steps and 108,704 rows, 46.7 h projected at the S0 14B
# cell rates [D]; the plan stage re-projects from the measured rates before the run bills
HOURS=50
# S1 fetched 28 GB of weights in 15 min of setup (about 290 MB/s) [V]; 141 GB plus
# the helpers at that rate are about 25 min [D]; 40 holds a slower mirror
SETUP_BOUND_MIN=40
# S2 block F batch 2/3 spec finding 4, decision 3 option (a) (owner 2026-11-03): this
# landing ladders 15 triples per engine (30 in all), which exceed the S1 bound of 18,000 s
# at the S1 pace; 32,400 s (9 h per engine) holds them; the 70B's window speed at TP 4 is [A]
CALIBRATE_RUNGS_BOUND_S=32400
# S1 scored 365,410 rows in 136 min row by row [V]; 108,704 rows at that rate are
# 41 min [D]; 120 holds rows three times slower (longer 70B answers are [A])
SCORE_BOUND_MIN=120
# ADR-0176 Group D, carried from S1: batched scoring behind the stage 10 probe
SCORING_BATCH_SIZE=32
# S2 block F row F-11 (owner 2026-11-04, option (a)): the per-row bounds the proof
# allows on the two continuous exploratory fields; every predicate input stays
# exact. 0.005 = 10 percent of the 0.05 window margin (S1 measured 0.0035);
# 1e-5 holds the measured 2.2e-6 with headroom.
SCORING_TOL_FAITHFULNESS=0.005
SCORING_TOL_BERTSCORE=1e-5
# S1 pulled its 14 GB run tree in 242 min [V]; 30 percent of the rows at that rate
# are 72 min [D]; 150 holds a link twice as slow
PULL_MARGIN_MIN=150
# seatbelt >= readiness 15 + setup 40 + validate (20 + pod suite 30 + 2 x 25 +
# start check 40) + calibrate 2 x (60 + 540) + plan 15 + run 3000 + seal 10 +
# score 120 + collect 30 + pull 150 = 4,720 min (78.7 h) [D, stage_bound_minutes];
# 83h = 4,980 min keeps the 260 min margin 75h held over the 18,000 s bound (decision 3)
SEATBELT=83h
# ADR-0177 bound, unused while CLASS_CEILINGS=0 (block E: no ceiling-only ladders on S2)
CLASS_CEILINGS_BOUND_S=36000
CLASS_CEILINGS=0
# S0F-88 B-9 (owner ruling R5): every class laddered at its rungs
RUNG_ALL_CLASSES=1
# The served model plus the seven helpers; no Qwen3-14B on S2 (no pod reader defaults to it)
PREFETCH_MODELS="meta-llama/Llama-3.3-70B-Instruct intfloat/e5-large-v2 BAAI/bge-reranker-large microsoft/llmlingua-2-xlm-roberta-large-meetingbank KRLabsOrg/lettucedect-base-modernbert-en-v1 MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli sentence-transformers/all-MiniLM-L6-v2 roberta-base"
# G14 hang guards, carried from S1 [A until the S2 step times are measured]
STEP_TIMEOUT_S=7200
LADDER_FAIL_FAST=1
CELL_STALL_MIN=60
BACKUP_ARCHIVE_DIR=/workspace/backup-archives
# S2 block F row F-10 (ADR-0185) and batch 2/3 spec finding 2, decision 2 option (B)
# (owner 2026-11-03): the E12 gate judges the two registered pressure loads exactly, at
# the count the grid registers per group (2 windows at 0.95, 3 at 1.05); the block E
# floor of six was unreachable by construction. The roster names the confirmatory arms:
# their groups block the landing, the other arms' groups are descriptive (projection
# 2026-11-03: 72 gated groups, 64 blocking, 8 descriptive).
REGIME_GATE_LOADS="0.95 1.05"
MIN_IN_REGIME_WINDOWS="0.95:2 1.05:3"
CONFIRMATORY_ARMS="B1 B3 B4 B6 B7 B11 B12"
# ADR-0175 item 7, carried from S1
MAX_NULL_FRACTION=0.06
# S0F-72, carried from S1 [A on four H200]: the floor table's concurrency target
FLOOR_CONCURRENCY=50
# ADR-0155: the anchor shape the s2a grid registers, the S0 Qasper mean served
# tokens in Qwen3-14B tokens (block A-7: the 70B-token shape is deferred to block C)
FLOOR_AVG_SEQ_TOKENS=4779
# Block E pick: the pod suite runs too; the Mac suite stays the free gate
SUITE_ON_POD=1
MAC_SUITE=1
FRONT_LOAD=0
# S0F-35 lever, carried from S1 [A on the 70B]
CAGE_SGLANG_DISABLE_PIECEWISE_CUDA_GRAPH=1
# No retr-store (B8) cell on s2a: no LMCache
INSTALL_LMCACHE=0
LMCACHE_VERSION=
# The s2a plan carries 4 blocked rows by construction (corpus-trunc on Qasper);
# stage 7 refuses them under 0. Owner decision pending: 1 runs the executable
# subset loudly (ADR-0144).
SKIP_BLOCKED=0
# S2 block E-2 (owner 2026-11-01): the owner's Hub token file on this Mac, outside
# the repo, mode 600, written unquoted so bash expands the ~. Stage 0 refuses a
# missing, empty, 644 or in-repo file before anything bills; stage 2 copies it to
# the pod's token path as a file. The token never enters a variable or a log.
HF_TOKEN_FILE=~/.cache/huggingface/token
