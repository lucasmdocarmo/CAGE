# S3 (extra, deferred by the owner on 2026-10-03): Group D single-node
# [Extension], DeepSeek-V3-0324 FP8 on 8x H200. NOT runnable: `cd-act2` is
# refused by run_campaign.py until registered. A later GO is a money decision.
EXP=S3
SESSION=cd-act2
CAMPAIGN=camp1
# [A] HF model id; confirm on the Hub before the GO.
MODEL=deepseek-ai/DeepSeek-V3-0324
MODEL_SLUG=deepseek-v3
GPU_ID="NVIDIA H200"
GPU_COUNT=8
ENGINES="vllm sglang"
CALIBRATE="vllm sglang"
TOPOLOGY=tp
HOURS=24
# ADR-0154: the rung count of cd-act2 is unknown until its grid is registered
# [?]; the default CALIBRATE_RUNGS_BOUND_S (9,000 s, 3 rungs at the ceiling)
# is what the seatbelt below covers; re-derive both at the GO.
# seatbelt >= 25 + 50 + 120 + calibrate-rungs 2x150 + 15 + 1440 + 180 + 30 + 60 = 2,220 min (37 h)
SEATBELT=38h
DISK_GB=300
VOLUME_GB=1000
PREFETCH_MODELS="deepseek-ai/DeepSeek-V3-0324"
