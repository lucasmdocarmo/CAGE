# CAGE experiment profile: defaults every <S>.env inherits (ADR-0143).
# Sourced by scripts/6_experiments/cage_experiment.sh under `set -a` BEFORE
# the stage profile, so a stage profile overrides any key here. Plain
# KEY=VALUE lines only (bash 3.2 on the Mac reads them); no command
# substitution, no arrays. The resolved values are frozen into
# experiments/<S>/<date>/extras/profile.env at stage 0.
#
# Provenance of the defaults: the RunPod capability record of 2026-09-26
# (image, disk, seatbelt), the S0 day of 2026-09-30 (datasets, engines),
# and the owner's answers of 2026-10-06 (monitor cadence, balance floor,
# backup scheme, folder letter). Values tagged [A] are assumptions the
# owner can change before the first live run.

# --- pod shape (provision_pod.sh) -------------------------------------------
CAGE_POD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404
GPU_COUNT=1
DISK_GB=120
VOLUME_GB=100
CLOUD_TYPE=SECURE
PORTS=22/tcp
# The seatbelt is the client-side watchdog deadline; size it to the run.
SEATBELT=24h
# Planned hours, for the plan's cost estimate and the run job's wall bound.
HOURS=20
SETUP_BOUND_MIN=25
# Datacenter preference order for the volume and the pod (first that accepts).
DC_PREFS="US-NE-1 US-CA-2"

# --- what the pod stages (setup_runpod.sh) ----------------------------------
# No `ruler` here: download_datasets.py refuses it and setup would print a
# WARNING that fails stage 3 (drift sweep 2026-10-06). RULER is generated.
CHARTER_DATASETS="squad_v2 musique qasper"
PREFETCH_MODELS="Qwen/Qwen3-14B"

# --- engines, calibration, planning -----------------------------------------
ENGINES="vllm sglang hf"
CALIBRATE="vllm sglang"
TOPOLOGY=single
# calibrate_cell.py inputs (charter 6.1: r = 1.5, concurrency 1).
CALIBRATION_BUDGET_FRACTION=1.5
CALIBRATION_MANIFEST=data/manifests/squad_v2_50x3_seed42.json
# ADR-0154 (S0F-62) and ADR-0156: lambda* per budget rung, measured by
# run_campaign.py calibrate-rungs under the plan's own relaunch (stage 5, one
# job per CALIBRATE engine) on TWO classes: the anchor (gold-fresh) and the
# engine's smallest executable class (retr-trunc on both registered sessions);
# the classes in between are interpolated by the plan. Empty = every budgeted
# rung of the session (run_campaign.py rungs; the rehearsal's collapsed rungs
# under REHEARSAL_N). A comma list (e.g. "1.5,1,0.5") restricts it. The job
# bound per engine. ADR-0162 (S0 attempt 2, 2026-10-10): a probe is a full runner
# invocation, measured 3 min 18 s on the anchor (45 s relaunch + 75 s window +
# preparation) and 11 min on the smallest class (CPU retrieval and reranking),
# with a 10 min FAISS index build on its first window [V], never the 85 s the
# 18,000 s figure assumed. Expected per engine: anchor 3 rungs x about 4 windows
# x 3.3 min plus smallest about 10 + 4 + 4 windows x 11 min, about 4 h; 25,200 s
# (7 h) is the bound [D]. A registered run with 7 rungs sets its own (S1.env).
CALIBRATE_RUNGS=
CALIBRATE_RUNGS_BOUND_S=25200
# build_floor_table.py inputs (planner inputs c, s, f; [A] until the owner pins them).
FLOOR_ENGINE=vllm
FLOOR_CONCURRENCY=8
# ADR-0155 (S0F-63): the shape D is sized on MUST be the registered anchor arm's
# served tokens (gold-fresh, prompt + output, measured on the 2026-10-08 landing:
# run_campaign.DEMAND_SEQ_TOKENS_2026_10_08); stage 0 and the plan refuse any
# other value. The other arms' budgets are scaled from it per demand class.
FLOOR_AVG_SEQ_TOKENS=4779
FLOOR_SERVICE_TIME_S=4.0
FLOOR_GRID=anchor-fine
# cache_budget byte plans, one per r in this list.
BUDGET_RATIOS="0.5 1.0 1.5"
# run_campaign.py plan inputs.
WINDOW_DURATION_S=600
SEED=42
# ADR-0144: a dress rehearsal derives its grid from the registered session
# (plan --rehearsal-n N: every arm, engine, hf cell, RULER task and rung; the
# F2/F3 axes collapsed; one window per cell; every row class at N). Empty = the
# registered plan. Never set on a registered run.
REHEARSAL_N=
# Consent to run the executable subset of a plan that carries blocked cells
# (run_campaign.py run --skip-blocked; the master applies it only when the
# plan has blocked_row_keys and says so). 0 = stage 7 refuses such a plan.
SKIP_BLOCKED=0
# S0F-57 / ADR-0158: install the LMCache KV-connector package (the retr-store arm
# B8 on vLLM) in the pod bootstrap. Profiles whose plan has executable vLLM B8
# cells set 1 (stage 0 prints NEEDS_LMCACHE from the registered plan; stage 4
# proves the import). LMCACHE_VERSION pins the wheel when set.
INSTALL_LMCACHE=0
LMCACHE_VERSION=
# Only manifests that exist in the repo (stage 0 refuses a missing one); musique has
# none yet (build it with scripts/1_setup/build_query_manifest.py before S1).
QUERY_MANIFESTS="squad_v2=data/manifests/squad_v2_50x3_seed42.json qasper=data/manifests/qasper_50x3_seed42.json"
# Pod-side python for the driver and the scoring pass (ADR-0125 venv link).
POD_PYTHON=cage-env/bin/python
VLLM_START_TIMEOUT=600
# ADR-0162: SGLang starts took 200 to 208 s of the launcher's 300 s default on
# the H100 (model load + CUDA graphs + an 80 s Hub check) [V 2026-10-09].
SGLANG_START_TIMEOUT=600

# --- scoring (stage 10) -----------------------------------------------------
SCORING_RUN_ID=full-cuda-1
# The refusal bound of build_predicate_table.py (--max-null-fraction): the largest
# share of ungraded (predicate None) rows one window may hold before the build
# refuses. 1.0 = the stop never fires; the PROVISIONAL dry-run value (owner,
# 2026-10-06, as at S0), never the registered one: the registered bound is set
# at the D9 freeze before the confirmatory look. The per-window ungraded share
# is printed in plots/analysis.txt section 3 so a thin window is read, not hidden.
MAX_NULL_FRACTION=1.0

# --- backup, monitor, money -------------------------------------------------
BACKUP_SCHEME=file
BACKUP_TARGET=file:///workspace/backup
BACKUP_INTERVAL_S=300
MONITOR_INTERVAL_S=120
BALANCE_FLOOR_USD=50
# Per-cell stall bound for the monitor's "journal old and GPU idle" alert.
CELL_STALL_MIN=30

# --- analysis (stage 13) ----------------------------------------------------
CONTRASTS="4"

# --- stage 0 gate -----------------------------------------------------------
# The Mac suite runs before anything bills. 0 skips that one step loudly (the
# profile vouches for HEAD and says why; SUITE_ON_POD=1 keeps the suite on the
# pod); every other stage 0 check stays. Never 0 on a registered run (ADR-0145).
MAC_SUITE=1

# --- validate-stage extras (S0 only; refused as not built when set to 1) ----
SUITE_ON_POD=0
NEGATIVE_CONTROLS=0
PD_PROBES=0

# --- ssh --------------------------------------------------------------------
# Private key for the pod: the account's runpodctl key. The empty default
# (ssh's own identity) was refused live on 2026-10-07 ("Permission denied
# (publickey,password)", pod 3frfsjtia1tk1q, $0.07): the pod trusts only the
# key `runpodctl ssh info` names, and the tilde expands when this is sourced.
SSH_KEY=~/.runpod/ssh/runpodctl-ssh-key
