# S2: Group C single-node plus the anchor's iso-model PD overlay (owner's
# decision of 2026-10-03). NOT runnable yet: run_campaign.py registers grids
# `a` and `b` only, so stage 6 refuses `cd-act1` until its grid lands
# (drift sweep 2026-10-06). Kept so a later GO is a money decision only.
EXP=S2
SESSION=cd-act1
CAMPAIGN=camp1
# [A] HF model id of Qwen3-Next-80B-A3B; confirm on the Hub before the GO.
MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
MODEL_SLUG=qwen3-next-80b
# [A] RunPod gpu id spelling; stage 0's stock read validates it fail-closed.
GPU_ID="NVIDIA H200"
GPU_COUNT=4
ENGINES="vllm sglang"
CALIBRATE="vllm sglang"
TOPOLOGY=tp
HOURS=24
# ADR-0154: the rung count of cd-act1 is unknown until its grid is registered
# [?]; the default CALIBRATE_RUNGS_BOUND_S (25,200 s since ADR-0162: measured
# probe durations, 2 classes x 3 rungs) is what the seatbelt below covers;
# re-derive both at the GO.
# seatbelt >= 25 + 50 + 120 + calibrate-rungs 2x420 + 15 + 1440 + 180 + 30 + 60 = 2,760 min (46 h)
SEATBELT=47h
DISK_GB=200
VOLUME_GB=300
PREFETCH_MODELS="Qwen/Qwen3-Next-80B-A3B-Instruct Qwen/Qwen3-14B"
