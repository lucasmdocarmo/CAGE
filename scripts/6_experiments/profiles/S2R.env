# S2 REHEARSAL (owner 2026-11-04, option R1, "lets do the test with the h200 as designed"):
# S2B.env's exact shape, the 80B on MuSiQue, four H200 at TP 4, vLLM and SGLang, every
# ladder, driven through every stage of the master once and cut short at the run, before
# landing B bills. Never a landing of record: its tree measures the stages, it is not a
# result. Twelve keys differ from S2B.env (EXP, HOURS, RUN_BUDGET_HOURS, RUN_CUT_BY_BUDGET,
# SEATBELT, SCORE_BOUND_MIN, PULL_MARGIN_MIN, VOLUME_GB, MIN_IN_REGIME_WINDOWS, SKIP_BLOCKED,
# IDENTITY_FAIL_ACCEPTED, PD_FAIL_ACCEPTED);
# tests/test_s2_rehearsal_profile.py holds S2R to S2B on every other key. Landing note:
# MyDocs/RunPod/S2_REHEARSAL_LANDING_2026-11-05.md.
EXP=S2R
SESSION=cd-act1
# S2 block F batch 2/3 spec finding 1, decision 1 (owner 2026-11-03): the ladder registers
# the floor artifact at the grid's floor rung (floor_budget_r = 1.0 on this session) and
# stage 5 refuses any other fraction, so the S1 control rung 1.25 (ADR-0175 item 5) is out
CALIBRATION_BUDGET_FRACTION=1.0
# B4, carried from S1: each class's floor on the floor start
CLASS_FLOORS=1
# ADR-0175 amendment, carried from S1: the loads from the frontier rule on the anchor ladders
FRONTIER_LOADS=1
# S2 block A-6 (DEC-2 (b)): the MuSiQue questions packed in the 80B's own tokens
# (490 blocks of 2,640 tokens, pool 2,407, 50-question warm-up reserve, trial pool
# 2,357; tokenizer revision 9c7f2fbe84465e40164a94cc16cd30b6999b0cc7). The same
# file calibrates the ladders (490 blocks exceed the 30 distinct prompts the floor needs).
QUERY_MANIFESTS="musique=data/manifests/musique_2000x3_seed42_wr50_tok-Qwen3-Next-80B-A3B-Instruct.json"
CALIBRATION_MANIFEST=data/manifests/musique_2000x3_seed42_wr50_tok-Qwen3-Next-80B-A3B-Instruct.json
# CHARTER_DATASETS stays the common three (the preflight needs every plan dataset
# staged, not the reverse); narrowing it to musique would only trim the staging time.
# Block B-4 option a: the weights on the 300 GB container disk. Rehearsal: the volume
# carries the repo, the one hour tree and the backup; the owner deletes it by hand after
# the pull (no script ever deletes a volume). 100 is the owner's pick of 2026-11-04; 300
# would keep it reusable for landing B through CAGE_VOLUME_ID_OVERRIDE (block B-6).
VOLUME_GB=100
DISK_GB=300
# Rehearsal: the budget stop 1.25 h into the run; exit 4 seals the tree with sentinels
# and passes on a registered profile (ADR-0175 item 1; cage_experiment.sh 2167 to 2186).
# 1.25 (owner 2026-11-05): the first segment projects 3,277 s on the Mac-built plan, so 1 h
# left 323 s of spare and 1.25 h leaves 1,223 s; the second segment needs 2.5 h either way.
RUN_BUDGET_HOURS=1.25
# ADR-0190 (owner 2026-11-05, option D): the cd-act1 plan projects about 38 h, past HOURS;
# the budget stop above is the cut, so stage 6 warns instead of refusing. S2B.env keeps the
# whole-plan refusal (its key is empty); this file is never a landing of record.
RUN_CUT_BY_BUDGET=1
LAST_BLOCK=
# A10: the served model at its freeze-file revision (slot served_model_qwen3_next_80b,
# read 2026-11-01), offline, checked against the Hub at setup
PIN_MODEL_REVISION=1
CAMPAIGN=camp1
MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
MODEL_SLUG=qwen3-next-80b
# RunPod gpu id spelling; stage 0's stock read validates it fail-closed.
GPU_ID="NVIDIA H200"
GPU_COUNT=4
# The cd-act1 plan has no hf cell; both served engines are calibrated
ENGINES="vllm sglang"
CALIBRATE="vllm sglang"
TOPOLOGY=tp
# S2 plan decision 8 (2026-10-30); the volume binds this landing to landing A's datacenter
DC_PREFS="US-CA-2 US-CO-1 CA-MTL-3 CA-MTL-4 EU-FR-1 AP-JP-1"
# Rehearsal: the run bound. The budget stop above is checked only before a relaunch and
# admits a whole segment (the relaunch and its steps up to the next relaunch) when the
# plan's table projection says it ends before the stop (run_campaign.py _past_budget), so
# an admitted segment can outlive the stop: the cd-act1 first segment (one SGLang relaunch,
# a dry window, five Y1 cells) projects 3,277 s on the 14B table [V 2026-11-05, the plan
# built on the Mac], at the 80B's pace [A] longer, each step capped by STEP_TIMEOUT_S (two
# hours). At the bound pod_job.sh returns 124 without killing the job and stage 7 fails
# "STILL RUNNING"; the pod then bills until the owner's hand or the seatbelt. [A] accepted
# 2026-11-05 (review MEDIUM 1): three hours cover one admitted segment at up to three times
# the table's pace (S2B keeps five hours).
HOURS=3
# S1 fetched 28 GB of weights in 15 min of setup (about 290 MB/s) [V]; 163 GB plus
# the helpers at that rate are about 28 min [D], plus the LMCache install [A]; 50 holds a slower mirror
SETUP_BOUND_MIN=50
# S2 block F batch 2/3 spec finding 4, decision 3 option (a) (owner 2026-11-03): this
# landing ladders 15 triples per engine (30 in all), which exceed the S1 bound of 18,000 s
# at the S1 pace; 32,400 s (9 h per engine) holds them; the 80B's window speed at TP 4 is [A]
CALIBRATE_RUNGS_BOUND_S=32400
# Rehearsal: a one hour tree holds a few windows; S1 scored 365,410 rows in 136 min [V]
SCORE_BOUND_MIN=60
# ADR-0176 Group D, carried from S1: batched scoring behind the stage 10 probe
SCORING_BATCH_SIZE=32
# S2 block F row F-11 (owner 2026-11-04, option (a)): the per-row bounds the proof
# allows on the two continuous exploratory fields; every predicate input stays
# exact. 0.005 = 10 percent of the 0.05 window margin (S1 measured 0.0035);
# 1e-5 holds the measured 2.2e-6 with headroom.
SCORING_TOL_FAITHFULNESS=0.005
SCORING_TOL_BERTSCORE=1e-5
# Rehearsal: a one hour tree is a few hundred MB; S1 pulled 14 GB in 242 min [V]
PULL_MARGIN_MIN=60
# seatbelt >= readiness 15 + setup 50 + validate (20 + pod suite 125 + 2 x 25 +
# start check 40 + identity gate 60 + PD smoke 40) + calibrate 2 x (60 + 540) + plan 15 +
# run 180 + seal 10 + score 60 + collect 30 + pull 60 = 1,955 min (32.6 h)
# [D, stage_bound_minutes]; 35h = 2,100 min keeps a 145 min margin (ADR-0196 raised the
# pod suite from 30 to 125 min and the seatbelt from 33h; the sum was 1,860). The money
# gate charges the 1,955 min at four times the live H200 secure price plus the 50 dollar
# floor: 32.6 h x 4 x 5.29 + 50 = 739.82 dollars at the 5.29 read on 2026-11-04 (the
# master rounds the hours to one decimal first; 705.96 before).
SEATBELT=35h
# ADR-0177 bound, unused while CLASS_CEILINGS=0 (block E: no ceiling-only ladders on S2)
CLASS_CEILINGS_BOUND_S=36000
CLASS_CEILINGS=0
# S0F-88 B-9 (owner ruling R5): every class laddered at its rungs
RUNG_ALL_CLASSES=1
# The served model plus the seven helpers; no Qwen3-14B on S2 (no pod reader defaults to it)
PREFETCH_MODELS="Qwen/Qwen3-Next-80B-A3B-Instruct intfloat/e5-large-v2 BAAI/bge-reranker-large microsoft/llmlingua-2-xlm-roberta-large-meetingbank KRLabsOrg/lettucedect-base-modernbert-en-v1 MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli sentence-transformers/all-MiniLM-L6-v2 roberta-base"
# G14 hang guards, carried from S1 [A until the S2 step times are measured]
STEP_TIMEOUT_S=7200
LADDER_FAIL_FAST=1
CELL_STALL_MIN=60
BACKUP_ARCHIVE_DIR=/workspace/backup-archives
# S2 block F row F-10 (ADR-0185) and batch 2/3 spec finding 2, decision 2 option (B)
# (owner 2026-11-03): the E12 gate judges the two registered pressure loads exactly, at
# the count the grid registers per group (2 windows at 0.95, 3 at 1.05); the block E
# floor of six was unreachable by construction. The roster names every baseline this
# session serves, so every group blocks (projection 2026-11-03: 66 gated groups, all blocking; 60 since ADR-0193 took B8 out).
REGIME_GATE_LOADS="0.95 1.05"
# Rehearsal: empty = the counts print and nothing fails (the ADR-0176 "report only"
# form S1 ran under); S2B's floor "0.95:2 1.05:3" cannot be met by a one hour tree
MIN_IN_REGIME_WINDOWS=
# ADR-0193: B8 left the roster (its vLLM cells are blocked, its SGLang cell too).
CONFIRMATORY_ARMS="B1 B3 B4 B6 B7"
# ADR-0175 item 7, carried from S1
MAX_NULL_FRACTION=0.06
# S0F-72, carried from S1 [A on four H200]: the floor table's concurrency target
FLOOR_CONCURRENCY=50
# ADR-0155 and S2 block A-5 method (b): the cd-act1 anchor shape, the S1 MuSiQue
# gold-fresh prompts rebuilt in the 80B's tokens plus the S1 vLLM output counts
# (plots/demand_tables_20261101 of the S1 landing, 2026-11-01)
FLOOR_AVG_SEQ_TOKENS=2694
# Block E pick: the pod suite runs too; the Mac suite stays the free gate
SUITE_ON_POD=1
# ADR-0196: the 2026-11-07 rehearsal's pod suite took 4,821 s on this shape (one run) against
# the former 1,800 s; 7,500 s holds it with a 1.56x margin [A] and counts 125 min at stage 4
POD_SUITE_BOUND_S=7500
MAC_SUITE=1
FRONT_LOAD=0
# S0F-35 lever, carried from S1 [A on the 80B]
CAGE_SGLANG_DISABLE_PIECEWISE_CUDA_GRAPH=1
# S0F-57 / ADR-0158: the vLLM retr-store (B8) cells need the LMCache connector;
# setup installs the pinned wheel (block B-3, the lock's 0.4.4) and proves the import.
# Block E-3: no tensor-parallel key exists in the 0.4.x configuration; each TP rank
# reads LMCACHE_MAX_LOCAL_CPU_SIZE, so the stage 4 start check and the rehearsal
# pod are the proof of the store size at TP 4.
INSTALL_LMCACHE=1
LMCACHE_VERSION=0.4.4
# The cd-act1 plan carries 8 blocked rows by construction (retr-store on sglang:
# no connector knob; retr-store on vllm: ADR-0193, LMCache cannot serve the
# hybrid on vLLM 0.19.1). Rehearsal: 1 runs the executable subset and reports the skip
# loudly (ADR-0144), so stage 7 is reached; S2B's own value is the owner's pending
# decision. The 35 executable pd rows run only under the --allow-pd consent stage 7
# adds on a stage 4 PD smoke PASS (S2 block D, ADR-0182).
SKIP_BLOCKED=1
# S2 block C (charter 5.2): cd-act1 is identity gated; the gate keys stay at their
# common defaults (200 MuSiQue prompts from the manifest above, 3,600 s). On a FAIL
# verdict the owner writes IDENTITY_FAIL_ACCEPTED=1 here before the plan stage resumes.
# Owner acceptance 2026-11-10 (landing 2026-11-09_2233, pod nho3bc3xhdgs6v): comparison A
# 187/200 identical, B 200/200; the vLLM prefix-on cells of cd-act1 are excluded (blocked_on).
IDENTITY_FAIL_ACCEPTED=1
# Owner acceptance 2026-11-10 (same landing): the PD smoke's warm-up killed the decode
# engine (vLLM 0.19.1 align mode refuses external KV, scheduler.py:305), a FAIL since
# the 2026-11-10 amendment of pd_smoke.py; every pd cell of cd-act1 is excluded.
PD_FAIL_ACCEPTED=1
# S2 block E-2: the 80B is not gated; no token travels to this landing's pod
HF_TOKEN_FILE=
