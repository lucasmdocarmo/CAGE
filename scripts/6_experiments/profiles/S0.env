# S0: smoke, calibration and validation on a new engine build (the validation
# box of 2026-10-03 was dropped by the owner on 2026-10-06; this profile stays
# for any pre-stage smoke). Session `a` on the ops campaign slug `smoke`.
EXP=S0
SESSION=a
CAMPAIGN=smoke
# The anchor model: cache_budget's MODEL_KV registers qwen3-14b, llama-3.3-70b,
# deepseek-v3 and qwen3-next-80b only (review 2026-10-06, HIGH 3).
MODEL=Qwen/Qwen3-14B
MODEL_SLUG=qwen3-14b
GPU_ID="NVIDIA H100 80GB HBM3"
GPU_COUNT=1
ENGINES="vllm sglang"
CALIBRATE="vllm sglang"
TOPOLOGY=single
HOURS=4
# seatbelt >= setup 25 + validate 2x25 + calibrate 2x60 + plan 15 + run 240 + score 180 + collect 30 + pull 60 = 720 min
SEATBELT=14h
PREFETCH_MODELS="Qwen/Qwen3-14B"
# The S0 extras (suite on the pod, refusal controls, pd probes) are not built
# into the validate stage yet: stage 4 refuses when any is 1 (visible, never
# silent). Owner's default 6 of 2026-10-06 folds them in as tracked code later.
SUITE_ON_POD=1
NEGATIVE_CONTROLS=0
PD_PROBES=0
