# S2 landing B (session s2b): Qwen3-235B-A22B-Instruct-2507-FP8 on MuSiQue, four H200 at
# TP 4, vLLM and SGLang. Experiment A's grid on another model and dataset (owner 2026-11-21,
# "ok drop B7 from both, 8 arms. lets go"; 2026-11-22, "Yes, all seven";
# MyDocs/RunPod/S2_PLAN_A_B_QWEN3_235B_2026-11-19.md section 20). This file states the keys
# S2A.env states, with S2A's values except the model, the dataset, the disk, the setup and
# scoring bounds and the seatbelt, plus two keys S2A.env leaves at the common value, the engine
# start timeouts (tests/test_s2b_registration.py holds the two files together). Until
# 2026-11-22 it named session cd-act1 and the 80B (commit eadfd50); S2R.env keeps that profile.
EXP=S2B
SESSION=s2b
# S2 block F batch 2/3 spec finding 1, decision 1 (owner 2026-11-03): the ladder registers
# the floor artifact at the grid's floor rung (floor_budget_r = 1.0 on this session) and
# stage 5 refuses any other fraction, so the S1 control rung 1.25 (ADR-0175 item 5) is out
CALIBRATION_BUDGET_FRACTION=1.0
# B4, carried from S1: each class's floor on the floor start
CLASS_FLOORS=1
# FRONTIER_LOADS=0 (owner 2026-11-15, "ok A then"): the frontier rule (ADR-0175 amendment)
# places S1's K1 loads; no block of this session registers a frontier load (its loads are
# 0.95 and 1.05 of the cell's own rate), so the stage 6 frontier job could change nothing
# in the plan and could only refuse. tests/test_s2r_followups_batch3.py holds the key to the grid.
FRONTIER_LOADS=0
# The MuSiQue questions packed in the 235B's own tokens: 180 blocks of 2,640 tokens, a pool
# of 898 questions, 52 of them the warm-up reserve, so the trial pool is 846 and each of the
# three trials is those 846 in another order. Owner 2026-11-22 ("Rebuild on 846 questions",
# after the independent review): every no-load reference serves the whole pool (decision
# B-D2 (a), S2A's count), so every question a window serves under load has a reference, as on
# S2A; on the manifest built first (a trial pool of 2,357), 565 of the 1,210 questions served
# under load had none [V]. Built on 2026-11-22 with build_query_manifest.py --dataset musique
# --num-queries 846 --num-trials 3 --seed 42 --block-budget 2640 --trunc-budgets 700
# --warmup-reserve 52 --pool-target 896 --tokenizer Qwen/Qwen3-235B-A22B-Instruct-2507-FP8
# --tokenizer-revision e156cb4efae43fbee1a1ab073f946a1377e6b969. The blocks are the first 180
# of the 490 the 80B's manifest holds (the model's tokenizer.json is the 80B's file byte for
# byte) [V]. A window serves the first 500 questions of its trial; the three windows of a cell
# serve 797 distinct questions. The same file calibrates the ladders. The retrieval arms
# (B5, B6, B9) search every passage of the split, 21,100 documents (owner 2026-11-22, "Search
# whole split"): the planner registers the count of extra passages for session s2b, so this
# file states no key for it.
QUERY_MANIFESTS="musique=data/manifests/musique_846x3_seed42_wr52_tok-Qwen3-235B-A22B-Instruct-2507-FP8.json"
CALIBRATION_MANIFEST=data/manifests/musique_846x3_seed42_wr52_tok-Qwen3-235B-A22B-Instruct-2507-FP8.json
# CHARTER_DATASETS stays the common three: the preflight needs every plan dataset staged,
# and the stage 4 reranker probe scores 50 squad_v2 questions (probe_reranker_device.py), so
# a list narrowed to musique fails stage 4.
# DEC-1 (iv) and block B-4 option a: the weights on the container disk, with the results
# root and the backup mirror (POD_RESULTS_DIR below); the 300 GB volume carries the repo
# and the archive of the run tree (no script deletes it)
VOLUME_GB=300
# DISK_GB 500 (owner 2026-11-22, "500 GB on S2B"; S2A states 400 for its 141 GB of weights).
# The weights are 236 GB here. On the 80B rehearsal pod of 2026-11-14 (300 GB disk, 163 GB
# of weights) 91 GiB were free after the prefetch, so 37 to 57 GiB were held by everything
# but the weights [D: the disk counted in GB or in GiB, A]. On that count 400 GB would leave
# this landing 116 to 123 GiB after the prefetch, where the 80B on 400 GB had 184 to 191;
# 500 GB leaves 209 to 223 [D]. The same pod lost 26 GiB in the 18.6 h from stage 3 to stage
# 11, 2.7 GB of them explained [?]; at that rate the 89 hours of the seatbelt use about 124
# GiB [D]. The disk costs 0.10 USD per GB per month while the pod runs: 6.10 USD over the 89
# hours, 1.22 USD more than 400 GB [D]. Stage 3 fails below DISK_FREE_MIN_GB and stage 6
# projects the results against the space free then.
DISK_GB=500
# S2 plan section 6: the budget stop five hours before the HOURS bound, so the run
# seals its tree with sentinels instead of being killed at the bound (S2A's value; see HOURS)
RUN_BUDGET_HOURS=50
LAST_BLOCK=
# A10: the served model at its freeze-file revision (slot served_model_qwen3_235b_fp8,
# revision e156cb4efae43fbee1a1ab073f946a1377e6b969, read 2026-11-22), offline, checked
# against the Hub at setup. Stage 0 refuses this profile while the freeze file has no slot
# for the model.
PIN_MODEL_REVISION=1
CAMPAIGN=camp1
MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-FP8
MODEL_SLUG=qwen3-235b-fp8
# RunPod gpu id spelling; stage 0's stock read validates it fail-closed.
GPU_ID="NVIDIA H200"
GPU_COUNT=4
# The s2b plan has no hf cell; both served engines are calibrated
ENGINES="vllm sglang"
CALIBRATE="vllm sglang"
TOPOLOGY=tp
# S2 plan decision 8 (2026-10-30): volume-capable datacenters with H200 stock; re-read on GO day
DC_PREFS="US-CA-2 US-CO-1 CA-MTL-3 CA-MTL-4 EU-FR-1 AP-JP-1"
# The run bound, S2A's. The s2b grid is s2a's (82 cells, 178 windows, 226 plan steps) and
# projects the same 42.55 h on the S0 14B step table at the fixture's rates
# [V tests/test_s2b_registration.py]: that table is keyed by engine and retriever and
# scaled by the pool size, so it reads neither the model nor the prompt length. 55 leaves
# 12.45 h over that projection and the stop at 50 leaves 7.45 h, the room the owner kept on
# S2A (2026-11-22, "Keep 55/50/88"). The pod's figure is [?]: stage 6 projects again from
# the measured floors and compares with HOURS only, after calibration has billed. If it
# refuses, raise HOURS here and resume from the plan stage; the calibration is kept
# [V tests/test_s2a_eight_arms_master.py]. Limitation: the 235B has never run on a pod.
HOURS=55
# The 80B's 163 GB set up in 12.7, 14.2 and 21.8 min on the three fresh rehearsal pods
# (landings 2026-11-09, 2026-11-09_2233 and 2026-11-14, extras/state.json) [V]. Counting
# the slowest of them whole as download, the 236 GB of this model take at most 31.6 min
# [D: 21.8 x 236 / 163]; 50 holds 1.58 times that. S2A states 40 for its 141 GB.
SETUP_BOUND_MIN=50
# S2A's bound: 32,400 s (9 h per engine). This landing ladders 8 triples per engine (four
# classes at two rungs), as S2A does. The 80B rehearsal of 2026-11-14 laddered 30 triples
# in 579 min in all [V its state.json]; the 235B's window speed at TP 4 is [A].
CALIBRATE_RUNGS_BOUND_S=32400
# Owner 2026-11-22 ("180 min and 89h"); S2A states 120. This landing has S2A's nominal row
# count, 95,228 (160 windows of the 500-question pool plus 18 references of 846), not a
# served count. S1's scoring pass took 136 min for 365,410 served rows, of which 27,652 were
# scored and the rest inherited an earlier score: 0.295 s per scored row [V S1 score.log and
# state.json; D]. A score is reused only for identical scoring inputs (rescore_quality.py).
# If every one of the 15,228 reference rows is scored and every other row inherits, the pass
# takes 75 min at S1's speed [D]; 180 holds that 2.4 times. The ruling answered the first
# manifest, where 565 questions served under load had no reference and the same rule gave
# 24,268 scored rows and 119 min [D]; the rebuild on 846 questions removed that case, so
# S2A's 120 would hold the estimate 1.6 times here too. The share of this landing's rows
# that inherit is [?].
SCORE_BOUND_MIN=180
# ADR-0176 Group D, carried from S1: batched scoring behind the stage 10 probe
SCORING_BATCH_SIZE=32
# S2 block F row F-11 (owner 2026-11-04, option (a)): the per-row bounds the proof
# allows on the two continuous exploratory fields; every predicate input stays
# exact. 0.005 = 10 percent of the 0.05 window margin (S1 measured 0.0035);
# 1e-5 holds the measured 2.2e-6 with headroom.
SCORING_TOL_FAITHFULNESS=0.005
SCORING_TOL_BERTSCORE=1e-5
# S2A's value. It enters the seatbelt sum only; no stage stops a pull at it. S1 pulled its
# 14 GB run tree (365,410 served rows) in 242 min [V]; at that rate this landing's nominal
# 95,228 rows are 63 min and 150 holds 2.3 times the nominal count [D]. Two things that
# estimate leaves out: a window replays its pool up to 15 passes, and the pull carries the
# ladder trees too. The 80B rehearsal of 2026-11-14 pulled a 2.5 GB tree, most of it ladder
# windows of 30 triples, in 103.5 min [V its state.json]. Stage 6 prints the arrivals from
# the measured rates; the room for a longer pull is the 155 min the seatbelt keeps over the
# sum and whatever the earlier stages leave of their bounds.
PULL_MARGIN_MIN=150
# Owner 2026-11-22 ("180 min and 89h"). seatbelt >= readiness 15 + setup 50 + validate (20 +
# pod suite 125 + 2 x 25 + start check 40) + calibrate 2 x (60 + 540) + plan 15 + run 3300 +
# seal 10 + score 180 + collect 30 + pull 150 = 5,185 min (86.42 h, which the master prints
# as 86.4) [V the master's own plan print, tests/test_s2b_registration.py]; 89h = 5,340 min
# keeps a 155 min margin (S2A: 5,115 and 165 under 88h). Stage 0 asks for a balance of
# 86.4 h x 4 GPUs x the live H200 price + 50 USD: 1,878.22 USD at the 5.29 USD read on
# 2026-11-21 [D].
SEATBELT=89h
# ADR-0177 bound, unused while CLASS_CEILINGS=0 (block E: no ceiling-only ladders on S2)
CLASS_CEILINGS_BOUND_S=36000
CLASS_CEILINGS=0
# S0F-88 B-9 (owner ruling R5): every class laddered at its rungs
RUNG_ALL_CLASSES=1
# The served model plus the seven helpers; no Qwen3-14B on S2 (no pod reader defaults to it)
PREFETCH_MODELS="Qwen/Qwen3-235B-A22B-Instruct-2507-FP8 intfloat/e5-large-v2 BAAI/bge-reranker-large microsoft/llmlingua-2-xlm-roberta-large-meetingbank KRLabsOrg/lettucedect-base-modernbert-en-v1 MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli sentence-transformers/all-MiniLM-L6-v2 roberta-base"
# G14 hang guards, carried from S1 [A until the S2 step times are measured]
STEP_TIMEOUT_S=7200
LADDER_FAIL_FAST=1
CELL_STALL_MIN=60
BACKUP_ARCHIVE_DIR=/workspace/backup-archives
# S2R follow-ups item 6 (owner 2026-11-15, option B), as S0F-39 on S0 and as S2A.env: every
# cell directory is its row key, which carries "|"; the US-CA-2 network volume (NFS, vast
# backend), first in DC_PREFS, refused that character on landing S2R 2026-11-14 (EINVAL 22).
# The results root and the backup mirror live on the container disk; stage 12 pulls them to
# the Mac and the archive above stays on the volume. The pod's disk is not durable: a
# stopped pod loses both.
POD_RESULTS_DIR=/root/cage-results
POD_BACKUP_DIR=/root/backup
BACKUP_TARGET=file:///root/backup
# The gate of S2A (owner decisions A-G1 and A-G2 of 2026-11-19, and D3 (a) of 2026-11-21 for
# this landing): only load 1.05 gates, at its three registered windows; the four core arms
# block and B2, B5, B9 and B10 are reported (projection: 32 gated groups, 16 blocking, 16
# descriptive; 48 windows must all qualify). The 0.95 windows are recorded and reported,
# never gated. Stage 0 refuses a roster arm the grid does not serve. Until 2026-11-22 this
# file gated both loads on the roster "B1 B3 B4 B6 B7" of the 80B session.
REGIME_GATE_LOADS="1.05"
MIN_IN_REGIME_WINDOWS="1.05:3"
CONFIRMATORY_ARMS="B1 B3 B4 B6"
# ADR-0175 item 7, carried from S1
MAX_NULL_FRACTION=0.06
# S2A's lists (AN-2, ADR-0211; owner 2026-11-22, decision B-D6 (a)): the look requests the
# seven no-load contrasts whose two arms this session serves, each registered for group C;
# every one resolves to one pair per engine on the cells the session plans
# (tests/test_s2b_registration.py). #9 (B8 against B6) is left out: B8 is not on s2b and the
# driver refuses the whole look on a contrast without cells. #6 (dense against keyword
# retrieval) is not listed either; both of its legs are served and it can be read by hand.
# The metrics are the registered pair of #4: first-token time and the accepted-answer predicate.
CONTRASTS="1 2 3 4 5 7 8"
ANALYSIS_METRICS="ttft_ms predicate"
# S0F-72, carried from S1 [A on four H200]: the floor table's concurrency target
FLOOR_CONCURRENCY=50
# ADR-0155: the anchor shape the s2b grid registers, the mean served tokens of the gold arm
# on MuSiQue in the 235B's tokens (S1's no-load windows re-rendered on 2026-11-22; equal to
# the 80B's count, the tokenizers being the same bytes). It is the mean over S1's 800 gold
# rows; on the 285 of them whose question this session serves the mean is 2,727 [V]. Stage 0
# refuses a value that differs from the grid's.
FLOOR_AVG_SEQ_TOKENS=2694
# Block E pick: the pod suite runs too; the Mac suite stays the free gate
SUITE_ON_POD=1
# ADR-0196: the pod suite took 4,821, 2,351, 2,130 and 5,736 s on the four rehearsal pods of
# this shape (landings 2026-11-07_1536, 2026-11-09, 2026-11-09_2233 and 2026-11-14,
# logs/setup/suite_pod.log) [V]; 7,500 s holds the slowest 1.31 times and counts 125 min at
# stage 4. Those runs collected 5,580 to 5,766 tests; the suite is larger now [A on its time].
POD_SUITE_BOUND_S=7500
MAC_SUITE=1
FRONT_LOAD=0
# S0F-35 lever, carried from S1 [A on the 235B]
CAGE_SGLANG_DISABLE_PIECEWISE_CUDA_GRAPH=1
# The engine start timeouts of this landing (S2A leaves both at the common 600 s). The 80B's
# first vLLM start on the pod of 2026-11-14 took 518 s of the 600; its later starts took 109
# to 166 s and SGLang's 89 to 170 s, launch to ready line [V the engine logs]. This model's
# weights are 236 GB against 163 GB: a first start that scales with the bytes takes about
# 750 s [D] and would time out at 600. 1000 holds that 1.33 times and stays under the stage 4
# start job's own deadline of 1,500 s, which the master fixes: the 80B's validate_vllm job
# took 913 s, 395 of them after its start [V the landing's step logs], so a start that uses
# the whole 1000 s leaves 500 s for those steps [D]. The later starts were fast because the
# weights stayed in the page cache: that pod had 1,007 GB of memory [V its state.json], which
# holds this model's 236 GB too [D]. The start check does three starts in one job of 2,400 s,
# also fixed in the master: on the 80B it took 664 s, 417 of them in the three starts [V]. It
# holds while a start stays under 717 s [D: (2,400 - 247) / 3]; three starts at the full
# 1,000 s would overrun it, and the waiter then leaves the job running (second review L4).
# The run projection charges 55 s per vLLM relaunch and 255 s per SGLang relaunch for any
# model; 34 relaunches of 750 s would add 5.6 h, inside the 7.45 h the stop keeps over the
# projection [D]. The 235B's start time is [?] until stage 4.
VLLM_START_TIMEOUT=1000
SGLANG_START_TIMEOUT=1000
# No retr-store (B8) cell on s2b since the ruling of 2026-11-21: no LMCache
INSTALL_LMCACHE=0
LMCACHE_VERSION=
# The s2b plan carries no blocked row (no B8, no PD cell, no identity gate), so stage 7
# runs every row under 0. A blocked row printed at stage 6 is a new reason: read it first.
SKIP_BLOCKED=0
# The model is not gated on the Hub (license apache-2.0, read 2026-11-22): no token travels
# to this landing's pod
HF_TOKEN_FILE=
