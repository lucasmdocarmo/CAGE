# S1b: the Stage 1 remainder (the arms the S1 day could not fit), same pod
# shape and session as S1; a second date folder under experiments/S1b/.
EXP=S1b
SESSION=a
CAMPAIGN=camp1
MODEL=Qwen/Qwen3-14B
MODEL_SLUG=qwen3-14b
GPU_ID="NVIDIA H100 80GB HBM3"
GPU_COUNT=1
ENGINES="vllm sglang hf"
CALIBRATE="vllm sglang"
TOPOLOGY=single
# HOURS 12 to 15 (owner decision 2026-10-09, item 5; the ADR-0155 relaunches
# and the ADR-0153 dry windows, see S1.env).
HOURS=15
# ADR-0154 and ADR-0156: session a, 7 rungs x 2 classes per engine at the
# ladder ceiling (see S1.env).
CALIBRATE_RUNGS_BOUND_S=40800
# seatbelt >= 25 + 50 + 120 + calibrate-rungs 2x680 + 15 + 900 + 180 + 30 + 60 = 2,740 min (45.7 h)
SEATBELT=47h
PREFETCH_MODELS="Qwen/Qwen3-14B"
# Gap triage 2026-10-09 (C1): see S1.env.
SKIP_BLOCKED=1
# S0F-72 and S0F-57: see S1.env.
FLOOR_CONCURRENCY=50
CAGE_SGLANG_DISABLE_PIECEWISE_CUDA_GRAPH=1
INSTALL_LMCACHE=1
