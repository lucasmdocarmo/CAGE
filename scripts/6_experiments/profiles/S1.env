# S1: Stage 1 plus its 1b remainder, the anchor (owner's structure of 2026-10-03;
# MyDocs/RunPod/MINIMAL_EXPERIMENT_PLAN_2026-09-11.md section 2.5). The driver's
# registered session `a` is larger than the reduced grid the owner structured;
# stage 6 runs the registered grid until the reduced one is registered
# (MyDocs/Publication/PUBLICATION.md section 4 item 2).
EXP=S1
# ADR-0175 (owner 2026-10-20, "ok go with run 2"): the Run 2 session. ADR-0176
# (owner 2026-10-22, MyDocs/RunPod/S1_PLAN_2026-10-22.md): its registered grid
# is K1 as registered plus P1, the pressure table; K2 to L6 go to S2.
SESSION=s1
# ADR-0175 item 5: the control rung 1.25 is the floor rung (1.5 does not fit at c = 50)
CALIBRATION_BUDGET_FRACTION=1.25
# B4 (owner 2026-10-20, "One start, cut prompts"): each class's floor on the floor start
CLASS_FLOORS=1
# ADR-0175 amendment: the K1 loads from the frontier rule on the anchor ladders
FRONTIER_LOADS=1
# K1 serves 12 windows (the 12-trial Qasper set, sha256 5ddf5098); the S1 SQuAD v2
# set is 2,000 questions per trial from a 2,102-question pool, about 95 percent
# repeated between trials (1,809 in all three; ADR-0175 item 7)
# ADR-0176 Group E (owner 2026-10-23): the MuSiQue questions registered too, one
# trial of 2,000 (the primary n of B3 and B6 on vLLM; the other cells take the
# first 800, the hf cell the first 300) from the 2,417-question validation split
# with a 50-question warm-up reserve, trial pool 2,363 (sha256 438b577f); built
# 2026-10-23 with build_query_manifest.py --num-queries 2000 --num-trials 1.
QUERY_MANIFESTS="squad_v2=data/manifests/squad_v2_2000x3_seed42_wr50.json qasper=data/manifests/qasper_852x12_seed42_wr50.json musique=data/manifests/musique_2000x1_seed42_wr50.json"
CALIBRATION_MANIFEST=data/manifests/qasper_852x12_seed42_wr50.json
# ADR-0176: the three datasets _common.env stages (HotpotQA went to S2); no override.
# ADR-0174: one H100 SXM, secure cloud, volume 250 GB, container disk 150 GB
VOLUME_GB=250
DISK_GB=150
# ADR-0175 item 1: the budget stop. Owner 2026-10-22 (ADR-0176 Group B): 115 h,
# five hours before the HOURS bound, so the run seals its tree with sentinels
# instead of being killed mid-cell at the bound.
RUN_BUDGET_HOURS=115
# ADR-0176: the registered plan is K1 and P1; nothing to cut (empty = the whole plan).
LAST_BLOCK=
# A10 (owner 2026-10-20): the served model at its freeze-file revision, offline,
# checked against the Hub at setup (a newer head stops setup)
PIN_MODEL_REVISION=1
CAMPAIGN=camp1
MODEL=Qwen/Qwen3-14B
MODEL_SLUG=qwen3-14b
# [A] The S0 shape; the owner's A100-vs-H100 question is open (2026-10-06).
GPU_ID="NVIDIA H100 80GB HBM3"
GPU_COUNT=1
ENGINES="vllm sglang hf"
CALIBRATE="vllm sglang"
TOPOLOGY=single
# ADR-0176 (2026-10-22): the planner's linear rule projects 95 to 102 h for the
# approved grid with the S0 attempt 5 cell rows (plan doc section 16); the same
# rows under-project S0 attempt 5's own run by 21 percent [D], so HOURS = 120 is
# the most the balance allows, not a margin. The plan stage re-projects from the
# measured rates and refuses a plan past HOURS before the run bills.
HOURS=120
# ADR-0176: three budgeted rungs (1.25, 0.5, 0.25) per engine on TWO classes (the
# anchor and retr-trunc); the per-engine rung calibration bound is the ladder
# ceiling, 2 x 3 x (32 windows x 85 s + a 180 s relaunch) = 17,400 s [D] (30
# ladder + 2 bisection windows; the 10 s per window overhead is [A]).
CALIBRATE_RUNGS_BOUND_S=18000
# The scoring bound on the H100 (owner 2026-10-22): 214,920 rows at the unbatched
# 0.31 s per row [V S0 attempt 5] = 18.5 h; 1,200 min is the ceiling, the
# batching below may cut the measured time.
SCORE_BOUND_MIN=1200
# ADR-0176 Group D (owner 2026-10-22, step 1): the entailment and completeness
# instruments batched 32 rows at a time, used only after the stage 10 probe
# proves the batched rows identical to the row-by-row rows on 50 real answers;
# the row-by-row path is the fallback and the bound above covers it.
SCORING_BATCH_SIZE=32
# ADR-0176 Group C: the ssh pull of about 11 GB of run tree (214,920 rows at
# about 50 KB per row [V S0 attempt 5: 402 MB for 7,900 rows]) plus a few GB of
# ladder windows; 300 min holds even at S0's 68 min per 4.4 GB [D].
PULL_MARGIN_MIN=300
# seatbelt >= readiness 15 + setup 25 + validate (10 + 2 x 25 + start check 40)
# + calibrate 2 x (60 + 300) + plan 15 + run 7200 (HOURS) + seal 10 + score 1200
# + collect 30 + pull 300 = 9,615 min (160.3 h) (audit 2026-10-17 G16 terms);
# ADR-0177 (CLASS_CEILINGS=1) adds to the plan stage 2 x 600 (the ceiling-only
# ladders, CLASS_CEILINGS_BOUND_S per engine) + 60 (re-label and drift window)
# = 1,260 min; the master's own sum (validate 110 since the S1 audit's 10 min
# offline probe) is 10,885 min (181.4 h) [D, stage_bound_minutes]
SEATBELT=182h
# ADR-0177 (review 2026-10-25 H1): the ceiling-only ladder job bound per engine.
# Each interpolated class climbs from its own class-floor start (A16): about 94
# to 98 windows per engine at stage 5's measured 222 s per window (46 windows in
# 10,195 s), 21,600 to 24,100 s [D]; 36,000 s holds that with 1.5x margin.
CLASS_CEILINGS_BOUND_S=36000
# ADR-0177 (owner 2026-10-25, option A2): the plan stage measures a fill ceiling
# for every class it interpolates (ceiling-only ladders, rates unchanged), re-plans
# with the ceilings pinned behind a diff gate, re-judges the windows already
# written, and reruns one completed window as the drift record (record only)
CLASS_CEILINGS=1
# G15 (2026-10-17): PREFETCH_MODELS is inherited from _common.env (every model the
# run loads); the single-model override that stood here would have downloaded the
# retriever, the reranker, the compressor and the four scorers mid-run.
# G14 (2026-10-17): the hang guards on a registered run. STEP_TIMEOUT_S bounds every
# run and ladder step; [A] 7,200 s until C3 measures the S1 step times (the longest
# S0 step, a rerank cell with three windows, ran well under 1 h); LADDER_FAIL_FAST
# stops a ladder at its first non-ESTIMATED rung.
STEP_TIMEOUT_S=7200
LADDER_FAIL_FAST=1
# G15: the S0 values a registered run needs (A5): the per-cell stall bound S0
# needed, the tar archive of the run tree beside the mirror.
CELL_STALL_MIN=60
BACKUP_ARCHIVE_DIR=/workspace/backup-archives
# ADR-0176 (owner 2026-10-22, "report only"): the E12 gate counts windows at a
# load of 1.0 or above and S1 offers 0.7, 0.85 and the frontier loads below
# 1.0, so it would fail every S1 landing; empty = the counts print, nothing fails.
MIN_IN_REGIME_WINDOWS=
# ADR-0175 item 7: the per-window bound on unscorable ok rows, from S0's share plus
# a margin. S0 scored 0 of 6,300 rows null over 91 windows of 50 or 100 rows
# (experiments/S0/2026-10-14_0016 predicate_manifest.json); the margin is the 95
# percent upper bound on a zero count at the smallest window, 3/50 = 0.06 [D].
MAX_NULL_FRACTION=0.06
# S0F-72 (gap triage 2026-10-09 C3; owner "proceed with recommendations"): the
# rehearsal-proven settings the registered run needs. c = 50 is the floor
# table's concurrency (the 2026-09-30 S0 choice); under the pool rule
# (ADR-0158) the common c = 8 cannot hold one gold request at r <= 0.75.
FLOOR_CONCURRENCY=50
# S0F-35 lever (see S0.env): SGLang 0.5.10.post1 died in its piecewise CUDA
# graph capture of Qwen3-14B on the live H100; the master forwards this.
CAGE_SGLANG_DISABLE_PIECEWISE_CUDA_GRAPH=1
# S0F-57 / ADR-0158: session a has executable vLLM retr-store (B8) cells.
# Owner 2026-10-23: B8 (the retrieval store) left S1 whole, so no cell needs
# the LMCache connector; stage 0 prints NEEDS_LMCACHE=0 and stage 4 skips the probe.
INSTALL_LMCACHE=0
# Gap triage 2026-10-09 (C1): the registered session a plan carries blocked
# cells by construction (retr-store on sglang: no connector knob; the B12
# rungs of datasets without a manifest), so stage 7 refuses the plan unless
# the consent is given; without it the refusal came after the calibration
# stages billed. The skipped cells are reported per cell (ADR-0144).
# Owner 2026-10-23: with B8 out of S1 and the three question files registered,
# the plan carries no blocked cell; a blocked cell is now a refusal, never a skip.
SKIP_BLOCKED=0
