# S1: Stage 1 plus its 1b remainder, the anchor (owner's structure of 2026-10-03;
# MyDocs/RunPod/MINIMAL_EXPERIMENT_PLAN_2026-09-11.md section 2.5). The driver's
# registered session `a` is larger than the reduced grid the owner structured;
# stage 6 runs the registered grid until the reduced one is registered
# (MyDocs/Publication/PUBLICATION.md section 4 item 2).
EXP=S1
SESSION=a
CAMPAIGN=camp1
MODEL=Qwen/Qwen3-14B
MODEL_SLUG=qwen3-14b
# [A] The S0 shape; the owner's A100-vs-H100 question is open (2026-10-06).
GPU_ID="NVIDIA H100 80GB HBM3"
GPU_COUNT=1
ENGINES="vllm sglang hf"
CALIBRATE="vllm sglang"
TOPOLOGY=single
HOURS=20
# ADR-0154: session a has 7 budgeted rungs per engine; the per-engine rung
# calibration bound is the ladder ceiling, 7 x (32 windows x 85 s + a 180 s
# relaunch) = 20,300 s [D] (30 ladder + 2 bisection windows; the 10 s per
# window overhead is [A]); the expected time is about 7 x 14 min [D]. ADR-0155
# raises the registered plan's relaunches from 36 to 96 (one byte budget per
# demand class at each r), about 60 x 2.5 min more run time [D]: HOURS is the
# owner's call before the GO.
CALIBRATE_RUNGS_BOUND_S=20400
# seatbelt >= setup 25 + validate 2x25 + calibrate 2x60 + calibrate-rungs 2x340
# + plan 15 + run 1200 + score 180 + collect 30 + pull 60 = 2,360 min (39.3 h)
SEATBELT=40h
PREFETCH_MODELS="Qwen/Qwen3-14B"
